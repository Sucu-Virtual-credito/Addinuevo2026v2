rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================
    //  REGLAS EN MODO PRUEBA (fáciles de publicar y que FUNCIONAN)
    //  Cualquier usuario autenticado (cliente anónimo y el bot)
    //  puede leer, crear, actualizar y borrar solicitudes.
    //  ⚠️ Cuando quieras endurecer esto, se usa el esquema esAdmin()
    //     con un token secreto. Por ahora, prioridad = que funcione.
    //  Requisito: Authentication → Anónimo habilitado.
    // =========================================================
    match /solicitudes/{sid} {
      allow read, create, update, delete: if request.auth != null;
    }
    // Estado del bot de Telegram (compatibilidad)
    match /bot_chats/{chatId} {
      allow read, write: if request.auth != null;
    }
  }
}