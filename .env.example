# ============================================
#  VARIABLES PARA DESARROLLO LOCAL (con vercel dev)
#  Copia esto a un archivo .env.local (NO lo subas a GitHub)
#  En producción se ponen en: Vercel → Project → Settings → Environment Variables
# ============================================

# 1) Bot de Telegram: el token te lo da @BotFather cuando creas el bot
TELEGRAM_BOT_TOKEN=123456:AA-xxxxxxx

# 2) Tu chat con el bot (el ID numérico del asesor). Cómo obtenerlo:
#    - Escríbele cualquier mensaje al bot, luego abre:
#      https://api.telegram.org/bot<TU_TOKEN>/getUpdates
#    - Busca "chat": { "id": <ESTE número> }
ADMIN_CHAT_ID=123456789

# 3) Datos de TU base de datos de Firebase (los ves en:
#    Consola Firebase → ⚙️ Configuración del proyecto → Tus apps → Aplicación web)
FIREBASE_API_KEY=AIzaSyTu-api-key
FIREBASE_PROJECT_ID=tu-proyecto-id

# 4) Token del asesor (debe coincidir con firestore.rules.json → esAdmin
#    y con index.html → ADMIN_TOKEN)
FIREBASE_ADMIN_TOKEN=CAMBIA-ESTE-TOKEN

# 5) URL pública del deploy (solo para documentar el webhook)
#    El webhook del bot debe quedar en: https://TU-DOMINIO/api/bot
APP_URL=https://tu-proyecto.vercel.app