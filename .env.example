# ============================================
#  VARIABLES PARA DESARROLLO LOCAL (con vercel dev)
#  Copia esto a un archivo .env.local (NO lo subas a GitHub)
#  En producción se ponen en: Vercel → Settings → Environment Variables
# ============================================

# 1) Tu webhook de Discord (lo agrega /api/notificar)
DISCORD_WEBHOOK=https://discord.com/api/webhooks/tu-webhook-aqui

# 2) Contraseña del dashboard (la valida /api/login)
DASH_PASS=cambia-esta-clave