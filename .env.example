# ============================================
#  VARIABLES DE ENTORNO — SOLO se ponen en Vercel
#  (Project → Settings → Environment Variables).
#
#  ⚠️ Ninguno de estos valores va en el código:
#  la página los pide a /api/config al cargar, y el
#  bot /api/bot los lee directo de Vercel.
# ============================================

# 1) Bot de Telegram (token que te da @BotFather)
TELEGRAM_BOT_TOKEN=123456:AA-xxxx

# 2) Chat del asesor (el número que sale en getUpdates)
ADMIN_CHAT_ID=123456789

# 3) Configuración de TU base de datos Firebase
#    (Consola Firebase → ⚙️ Configuración del proyecto → Tus apps → Web)
FIREBASE_API_KEY=AIzaSyEscribe-tu-api-key
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:xxxxxxxxxxxxxxxx

# 4) Token del asesor (debe ser IDÉNTICO al de firestore.rules.json → tokenAdmin())
#    👉 Cámbialo por uno tuyo y ponlo igual en las reglas de Firestore.
FIREBASE_ADMIN_TOKEN=CAMBIA-ESTE-TOKEN